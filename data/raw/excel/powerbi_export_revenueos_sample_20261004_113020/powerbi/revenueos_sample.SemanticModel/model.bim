            "expression": "AVERAGE(inventory[units_sold])",
            "formatString": "#,##0.00",
            "description": "Arithmetic average of units_sold in inventory",
            "displayFolder": "02 Core Metrics"
          },
          {
            "name": "Units Sold YTD",
            "expression": "TOTALYTD([Total Units Sold], dim_date[date])",
            "formatString": "#,0",
            "description": "Year-to-date calculation for Total Units Sold",
            "displayFolder": "04 Time Intelligence"
          },
          {
            "name": "Units Sold Prior Month",
            "expression": "CALCULATE([Total Units Sold], PREVIOUSMONTH(dim_date[date]))",
            "formatString": "#,0",
            "description": "Previous month value for Total Units Sold",
            "displayFolder": "04 Time Intelligence"
          },
          {
            "name": "Units Sold MoM %",
            "expression": "DIVIDE([Total Units Sold] - [Units Sold Prior Month], [Units Sold Prior Month], 0)",
            "formatString": "0.0%",
            "description": "Month-over-month growth percentage for Total Units Sold",
            "displayFolder": "04 Time Intelligence"
          },
          {
            "name": "Units Sold Prior Year",
            "expression": "CALCULATE([Total Units Sold], SAMEPERIODLASTYEAR(dim_date[date]))",

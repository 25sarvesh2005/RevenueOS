      {
        "name": "_Measures",
        "columns": [
          {
            "name": "Measure_Placeholder",
            "dataType": "string",
            "sourceColumn": "Measure_Placeholder",
            "isHidden": true
          }
        ],
        "measures": [
          {
            "name": "Payments Count",
            "expression": "DISTINCTCOUNT(payments[payment_id])",
            "formatString": "#,0",
            "description": "Distinct count of payment_id in payments",
            "displayFolder": "01 Volume & Counts"
          },
          {
            "name": "Total Amount",
            "expression": "SUM(payments[amount])",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "description": "Aggregated sum of amount in payments",
            "displayFolder": "02 Core Metrics"
          },
          {
            "name": "Average Amount",
            "expression": "AVERAGE(payments[amount])",
            "formatString": "\\$#,##0.00",
            "description": "Arithmetic average of amount in payments",
            "displayFolder": "02 Core Metrics"
          },
          {
            "name": "Amount YTD",
            "expression": "TOTALYTD([Total Amount], dim_date[date])",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "description": "Year-to-date calculation for Total Amount",
            "displayFolder": "04 Time Intelligence"
          },
          {
            "name": "Amount Prior Month",
            "expression": "CALCULATE([Total Amount], PREVIOUSMONTH(dim_date[date]))",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "description": "Previous month value for Total Amount",
            "displayFolder": "04 Time Intelligence"
          },
          {
            "name": "Amount MoM %",
            "expression": "DIVIDE([Total Amount] - [Amount Prior Month], [Amount Prior Month], 0)",
            "formatString": "0.0%",
            "description": "Month-over-month growth percentage for Total Amount",
            "displayFolder": "04 Time Intelligence"
          },
          {
            "name": "Amount Prior Year",
            "expression": "CALCULATE([Total Amount], SAMEPERIODLASTYEAR(dim_date[date]))",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "description": "Same period last year for Total Amount",
            "displayFolder": "04 Time Intelligence"
          },
          {
            "name": "Amount YoY %",
            "expression": "DIVIDE([Total Amount] - [Amount Prior Year], [Amount Prior Year], 0)",
            "formatString": "0.0%",
            "description": "Year-over-year growth percentage for Total Amount",
            "displayFolder": "04 Time Intelligence"
          },
          {
            "name": "Returns Count",
            "expression": "DISTINCTCOUNT(returns[return_id])",
            "formatString": "#,0",
            "description": "Distinct count of return_id in returns",
            "displayFolder": "01 Volume & Counts"
          },
          {
            "name": "Total Quantity Returned",
            "expression": "SUM(returns[quantity_returned])",
            "formatString": "#,0",
            "description": "Aggregated sum of quantity_returned in returns",
            "displayFolder": "02 Core Metrics"
          },
          {
            "name": "Average Quantity Returned",
            "expression": "AVERAGE(returns[quantity_returned])",
            "formatString": "#,##0.00",
            "description": "Arithmetic average of quantity_returned in returns",
            "displayFolder": "02 Core Metrics"
          },
          {
            "name": "Quantity Returned YTD",
            "expression": "TOTALYTD([Total Quantity Returned], dim_date[date])",
            "formatString": "#,0",
            "description": "Year-to-date calculation for Total Quantity Returned",
            "displayFolder": "04 Time Intelligence"
          },
          {
            "name": "Quantity Returned Prior Month",
            "expression": "CALCULATE([Total Quantity Returned], PREVIOUSMONTH(dim_date[date]))",
            "formatString": "#,0",
            "description": "Previous month value for Total Quantity Returned",
            "displayFolder": "04 Time Intelligence"
          },
          {
            "name": "Quantity Returned MoM %",
            "expression": "DIVIDE([Total Quantity Returned] - [Quantity Returned Prior Month], [Quantity Returned Prior Month], 0)",
            "formatString": "0.0%",
            "description": "Month-over-month growth percentage for Total Quantity Returned",
            "displayFolder": "04 Time Intelligence"
          },
          {
            "name": "Quantity Returned Prior Year",
            "expression": "CALCULATE([Total Quantity Returned], SAMEPERIODLASTYEAR(dim_date[date]))",
            "formatString": "#,0",
            "description": "Same period last year for Total Quantity Returned",
            "displayFolder": "04 Time Intelligence"
          },
          {
            "name": "Quantity Returned YoY %",
            "expression": "DIVIDE([Total Quantity Returned] - [Quantity Returned Prior Year], [Quantity Returned Prior Year], 0)",
            "formatString": "0.0%",
            "description": "Year-over-year growth percentage for Total Quantity Returned",
            "displayFolder": "04 Time Intelligence"
          },
          {
            "name": "Total Inventory Rows",
            "expression": "COUNTROWS(inventory)",
            "formatString": "#,0",
            "description": "Total rows in inventory",
            "displayFolder": "01 Volume & Counts"
          },
          {
            "name": "Total Units Available",
            "expression": "SUM(inventory[units_available])",
            "formatString": "#,0",
            "description": "Aggregated sum of units_available in inventory",
            "displayFolder": "02 Core Metrics"

// -------------------------------------------------------------------
// Category: 01 Volume & Counts
// -------------------------------------------------------------------
// Distinct count of payment_id in payments
// Format: #,0
Payments Count = 
DISTINCTCOUNT(payments[payment_id])

// Total rows in inventory
// Format: #,0
Total Inventory Rows = 
COUNTROWS(inventory)

// Total rows in marketing
// Format: #,0
Total Marketing Rows = 
COUNTROWS(marketing)


// -------------------------------------------------------------------
// Category: 02 Core Metrics
// -------------------------------------------------------------------
// Arithmetic average of amount in payments
// Format: \$#,##0.00
Average Amount = 
AVERAGE(payments[amount])

// Arithmetic average of clicks in marketing
// Format: #,##0.00
Average Clicks = 
AVERAGE(marketing[clicks])

// Arithmetic average of impressions in marketing
// Format: #,##0.00
Average Impressions = 
AVERAGE(marketing[impressions])

// Arithmetic average of orders_attributed in marketing
// Format: #,##0.00
Average Orders Attributed = 
AVERAGE(marketing[orders_attributed])

// Arithmetic average of revenue_attributed in marketing
// Format: \$#,##0.00
Average Revenue Attributed = 
AVERAGE(marketing[revenue_attributed])

// Arithmetic average of spend in marketing
// Format: \$#,##0.00
Average Spend = 
AVERAGE(marketing[spend])

// Arithmetic average of units_available in inventory
// Format: #,##0.00
Average Units Available = 
AVERAGE(inventory[units_available])

// Arithmetic average of units_reserved in inventory
// Format: #,##0.00
Average Units Reserved = 
AVERAGE(inventory[units_reserved])

// Arithmetic average of units_sold in inventory
// Format: #,##0.00
Average Units Sold = 
AVERAGE(inventory[units_sold])

// Aggregated sum of amount in payments
// Format: \$#,0;(\$#,0);\$#,0
Total Amount = 
SUM(payments[amount])

// Aggregated sum of clicks in marketing
// Format: #,0
Total Clicks = 
SUM(marketing[clicks])

// Aggregated sum of impressions in marketing
// Format: #,0
Total Impressions = 
SUM(marketing[impressions])

// Aggregated sum of orders_attributed in marketing
// Format: #,0
Total Orders Attributed = 
SUM(marketing[orders_attributed])

// Aggregated sum of revenue_attributed in marketing
// Format: \$#,0;(\$#,0);\$#,0
Total Revenue Attributed = 
SUM(marketing[revenue_attributed])

// Aggregated sum of spend in marketing
// Format: \$#,0;(\$#,0);\$#,0
Total Spend = 
SUM(marketing[spend])

// Aggregated sum of units_available in inventory
// Format: #,0
Total Units Available = 
SUM(inventory[units_available])

// Aggregated sum of units_reserved in inventory
// Format: #,0
Total Units Reserved = 

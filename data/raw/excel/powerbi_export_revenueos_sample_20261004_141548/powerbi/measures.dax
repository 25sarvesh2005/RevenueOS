// -------------------------------------------------------------------
// Category: 04 Time Intelligence
// -------------------------------------------------------------------
// Month-over-month growth percentage for Total Amount
// Format: 0.0%
Amount MoM % = 
DIVIDE([Total Amount] - [Amount Prior Month], [Amount Prior Month], 0)

// Previous month value for Total Amount
// Format: \$#,0;(\$#,0);\$#,0
Amount Prior Month = 
CALCULATE([Total Amount], PREVIOUSMONTH(dim_date[date]))

// Same period last year for Total Amount
// Format: \$#,0;(\$#,0);\$#,0
Amount Prior Year = 
CALCULATE([Total Amount], SAMEPERIODLASTYEAR(dim_date[date]))

// Year-to-date calculation for Total Amount
// Format: \$#,0;(\$#,0);\$#,0
Amount YTD = 
TOTALYTD([Total Amount], dim_date[date])

// Year-over-year growth percentage for Total Amount
// Format: 0.0%
Amount YoY % = 
DIVIDE([Total Amount] - [Amount Prior Year], [Amount Prior Year], 0)


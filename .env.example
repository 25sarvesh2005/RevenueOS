# RevenueOS Environment Variables
# Copy this file to .env and fill in your values
# Run: cp .env.example .env

# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=revenueos
DB_USER=revenueos
DB_PASSWORD=revenueos

# Schema Names
SCHEMA_BRONZE=bronze
SCHEMA_SILVER=silver
SCHEMA_GOLD=gold

# pgAdmin (browser DB UI at http://localhost:5050)
PGADMIN_EMAIL=admin@revenueos.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Pipeline Settings
LOG_LEVEL=INFO
PIPELINE_RUN_ID=auto   # Set to 'auto' or a fixed string like '2026-10-04-001'

# Anomaly Detection Thresholds
IQR_MULTIPLIER=1.5
ZSCORE_THRESHOLD=3.0
ISOLATION_FOREST_CONTAMINATION=0.05

# Revenue Leakage Thresholds
DISCOUNT_LEAKAGE_THRESHOLD=0.25     # 25% discount rate triggers flag
MARGIN_LEAKAGE_THRESHOLD=0.15       # Below 15% gross margin triggers flag
HIGH_RETURN_RATE_THRESHOLD=0.15     # 15% return rate threshold

# ===============================================================================
# RevenueOS Environment Configuration Template
# ===============================================================================
# Copy this file to .env and configure for your local or production deployment:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env containing production secrets to public git.
# All commercial deployments are strictly governed by the RevenueOS Commercial License.
# ===============================================================================

# 1. Platform Environment & Security
REVENUEOS_ENV=development             # 'development', 'staging', or 'production'
REVENUEOS_API_KEY=your-secure-revenueos-api-key-here  # Required if API authentication is enabled
TENANT_ID=default                      # Default tenant identifier for multi-tenant isolation

# 2. FastAPI Server Settings
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEFAULT_CURRENCY=$                     # Primary currency symbol ($, €, £, ₹, etc.)

# 3. PostgreSQL Warehouse Connection (Optional — File Mode works independently)
# WARNING: Change default credentials before deploying to any production environment!
DB_HOST=localhost
DB_PORT=5432
DB_NAME=revenueos
DB_USER=revenueos
DB_PASSWORD=revenueos

# 4. Warehouse Schemas
SCHEMA_BRONZE=bronze
SCHEMA_SILVER=silver
SCHEMA_GOLD=gold

# 5. pgAdmin Management UI (Docker deployment)
PGADMIN_EMAIL=admin@revenueos.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# 6. Pipeline Execution & Observability
LOG_LEVEL=INFO                         # DEBUG, INFO, WARNING, ERROR, CRITICAL
PIPELINE_RUN_ID=auto                   # 'auto' generates timestamped UUID; or specify fixed string

# 7. Statistical & ML Anomaly Detection Thresholds
IQR_MULTIPLIER=1.5                     # Outlier boundary multiplier for interquartile range
ZSCORE_THRESHOLD=3.0                   # Standard deviations threshold for Gaussian z-score
ISOLATION_FOREST_CONTAMINATION=0.05    # Contamination ratio for multivariate anomaly isolation

# 8. Revenue Leakage & Commercial Risk Triggers
DISCOUNT_LEAKAGE_THRESHOLD=0.25        # Discounts exceeding 25% trigger commercial audit alert
MARGIN_LEAKAGE_THRESHOLD=0.15          # Gross margin falling below 15% triggers triage alert
HIGH_RETURN_RATE_THRESHOLD=0.15        # Return rate exceeding 15% triggers logistics/quality alert
STOCKOUT_RISK_DAYS=14                  # Days of inventory remaining triggering stockout risk
DEAD_STOCK_DAYS=90                     # Days without velocity triggering dead inventory flag
